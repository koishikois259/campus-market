@startuml
' Component diagram AI draft v0.1, 2026-11-02.
' Reference: https://plantuml.com/zh/component-diagram
!pragma layout smetana
title 校园二手交易系统组件图 初稿
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam componentStyle uml2
skinparam shadowing false
skinparam roundcorner 0
skinparam componentBackgroundColor #F5F5F5
skinparam componentBorderColor #777777
skinparam interfaceBackgroundColor #FFFFFF
skinparam interfaceBorderColor #777777
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam ArrowColor #444444
skinparam nodesep 28
skinparam ranksep 35

component "用户界面\n买卖 / 代交 / 管理" as UI
interface "业务接口" as BusinessAPI

package "Java 应用后端" as Backend {
  component "应用入口\n请求处理 / 业务协调" as App
  component "身份与权限\n邮箱登录 / 角色与归属" as Identity
  package "业务模块" as Business {
    component "商品与库存\n审核发布 / 查询 / 数量" as Catalog
    component "预约与订单\n预约确认 / 取消 / 收货" as Trade
    component "支付与退款\n付款 / 结算 / 退款" as Finance
    component "交付与售后\n代交任务 / 退货验收" as Fulfillment
    component "平台管理\n举报 / 日志 / 统计" as Governance
    Trade .left.> Catalog : 占用 / 释放库存
    Fulfillment .right.> Finance : 验收后申请退款
    Catalog -[hidden]down-> Fulfillment
    Trade -[hidden]down-> Finance
    Fulfillment -[hidden]down-> Governance
  }
  App .left.> Identity : 权限检查
  App .down.> Business : 分派业务请求
}

component "邮箱服务" as MailProvider <<external>>
component "支付渠道\n初期使用模拟渠道" as PaymentProvider <<external>>
database "业务数据库\n用户 / 商品 / 交易 / 日志" as DB

UI .down.> BusinessAPI : 调用
BusinessAPI -down- App
Identity .down.> MailProvider : 验证码接口
Finance .down.> PaymentProvider : 通用支付接口
Business .down.> DB : 按模块持久化 / 事务
Identity .down.> DB : 用户与授权
MailProvider -[hidden]right-> DB
DB -[hidden]right-> PaymentProvider

legend bottom
  组件框：职责模块；圆形：接口；圆柱：数据存储。
  虚线箭头由调用方指向依赖方，不表示交易步骤的先后。
  各模块通过自己的数据访问代码使用同一数据库。
endlegend
@enduml
