package "交付与售后 fulfillment" #ECFEFF {
  class "平台代交任务\nDeliveryTask" as DeliveryTask <<entity>> {
    - 任务编号: UUID
    - 订单编号: UUID
    - 方案编号: UUID
    - 代交人编号: UUID
    - 分配管理员编号: UUID
    - 任务状态: DeliveryStatus
    - 分配时间: Instant
    - 取件时间: Instant [0..1]
    - 交件时间: Instant [0..1]
    - 失败原因: String [0..1]
    - 终止时间: Instant [0..1]
    - 版本号: long
    + 记录取件(courierId, now): void
    + 记录交件(courierId, now): void
    + 记录失败(reason): void
    + 终止原任务(now): void
  }
  class "售后申请\nAfterSaleRequest" as AfterSaleRequest <<aggregate root>> {
    - 售后编号: UUID
    - 订单编号: UUID
    - 买家编号: UUID
    - 卖家编号: UUID
    - 申请幂等键: String {unique per buyer}
    - 退货数量: int
    - 申请金额: BigDecimal
    - 申请原因: String
    - 提交时间: Instant
    - 卖家答复截止时间: Instant
    - 卖家答复: ConsentDecision
    - 卖家答复原因: String [0..1]
    - 卖家答复时间: Instant [0..1]
    - 超时提醒时间: Instant [0..1]
    - 退货提交时间: Instant [0..1]
    - 售后状态: AfterSaleStatus
    - 版本号: long
    + 记录卖家答复(decision, reason, now): void
    + 标记已退货(now): void
    + 进入退款处理(): void
  }
  class "售后沟通与证据\nAfterSaleMessage" as AfterSaleMessage <<entity>> {
    - 消息编号: UUID
    - 售后编号: UUID
    - 提交人编号: UUID
    - 内容: String
    - 附件地址集合: List<String>
    - 提交时间: Instant
  }
  class "管理员介入记录\nAfterSaleIntervention" as AfterSaleIntervention <<entity>> {
    - 介入编号: UUID
    - 售后编号: UUID
    - 申请买家编号: UUID
    - 管理员编号: UUID [0..1]
    - 申请时间: Instant
    - 结论: InterventionDecision
    - 结论依据: String [0..1]
    - 结论时间: Instant [0..1]
    + 记录核查结论(adminId, decision, reason): void
  }
  class "退货验收记录\nReturnInspection" as ReturnInspection <<entity>> {
    - 验收编号: UUID
    - 售后编号: UUID {unique}
    - 验收卖家编号: UUID
    - 退回数量: int
    - 验收通过数量: int
    - 退回品相: ReturnCondition
    - 验收结论: InspectionDecision
    - 证据地址集合: List<String>
    - 验收说明: String
    - 验收时间: Instant
    + 记录验收结果(quantity, condition): void
  }
  AfterSaleRequest "1" -- "0..*" AfterSaleMessage : 沟通与证据
  AfterSaleRequest "1" -- "0..*" AfterSaleIntervention : 拒绝或超时后介入
  AfterSaleRequest "1" -- "0..1" ReturnInspection : 退回后验收
}
