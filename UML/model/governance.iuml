package "治理、日志与统计 governance" #FFF1F2 {
  class "举报\nReport" as Report <<entity>> {
    - 举报编号: UUID
    - 举报人编号: UUID
    - 目标类型: ReportTargetType
    - 目标编号: UUID
    - 举报原因: String
    - 证据地址集合: List<String>
    - 提交时间: Instant
    - 处理管理员编号: UUID [0..1]
    - 处理状态: ReportStatus
    - 处理结论: String [0..1]
    - 处理时间: Instant [0..1]
    + 记录处理结论(adminId, conclusion): void
  }
  abstract class "违规限制\nRestriction" as Restriction <<entity>> {
    - 限制编号: UUID
    - 来源举报编号: UUID [0..1]
    - 设置管理员编号: UUID
    - 限制原因: String
    - 生效时间: Instant
    - 到期时间: Instant [0..1]
    - 解除管理员编号: UUID [0..1]
    - 解除时间: Instant [0..1]
    - 解除原因: String [0..1]
    + 记录管理员解除(adminId, reason, now): void
  }
  class "账号限制\nAccountRestriction" as AccountRestriction <<entity>> {
    - 用户编号: UUID
    - 受限权限集合: Set<PermissionCode>
  }
  class "商品限制\nProductRestriction" as ProductRestriction <<entity>> {
    - 商品编号: UUID
    - 处置方式: ProductRestrictionAction
  }
  class "关键操作日志\nAuditLog" as AuditLog <<append only>> {
    - 日志编号: UUID
    - 操作者类型: ActorType
    - 用户编号: UUID [0..1]
    - 自动任务代码: String [0..1]
    - 业务对象类型: String
    - 业务对象编号: UUID
    - 操作类型: String
    - 操作结果: OperationResult
    - 原因: String [0..1]
    - 发生时间: Instant
    - 关联请求编号: String
  }
  class "成交统计结果\nTradeStatistics" as TradeStatistics <<read model>> {
    - 查询范围: StatisticsScope
    - 卖家编号: UUID [0..1]
    - 原售卖成交数量: long
    - 原售卖成交金额: BigDecimal
    - 赠送完成数量: long
    - 成功售后退货数量: long
    - 成功售后退款金额: BigDecimal
    - /净售卖数量: long
    - /净售卖金额: BigDecimal
  }
  Restriction <|-- AccountRestriction
  Restriction <|-- ProductRestriction
  Report "0..1" -- "0..*" Restriction : 可产生限制
}
