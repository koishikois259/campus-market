package "预约与订单 trade" #FFF7ED {
  class "预约\nReservation" as Reservation <<entity>> {
    - 预约编号: UUID
    - 请求幂等键: String {unique per buyer}
    - 买家编号: UUID
    - 商品编号: UUID
    - 预约数量: int
    - 卖家答复: SellerDecision
    - 创建时间: Instant
    - 确认截止时间: Instant
    - 卖家答复时间: Instant [0..1]
    - 库存占用状态: HoldStatus
    - 版本号: long
    + 接受(now): void
    + 拒绝(reason, now): void
    + 标记占用已释放(): void
  }
  class "订单\nOrder" as Order <<aggregate root>> {
    - 订单编号: UUID
    - 买家编号: UUID
    - 卖家编号: UUID
    - 商品编号: UUID
    - 订单状态: OrderStatus
    - 创建时间: Instant
    - 付款截止时间: Instant [0..1]
    - 收货确认时间: Instant [0..1]
    - 完成时间: Instant [0..1]
    - 取消时间: Instant [0..1]
    - 取消原因类型: CancelReason [0..1]
    - 取消原因说明: String [0..1]
    - 版本号: long
    + 应用已达成方案(agreementId): void
    + 确认收货(buyerId, now): void
    + 校验完成条件(paid, delivered): boolean
    + 完成(now): void
    + 取消(reason, now): void
  }
  class "订单商品快照\nOrderSnapshot" as OrderSnapshot <<immutable value object>> {
    - 商品名称: String {readOnly}
    - 商品内容版本: long {readOnly}
    - 单价: BigDecimal {readOnly}
    - 数量: int {readOnly}
    - 交易类型: TradeType {readOnly}
    - 售后声明: AfterSalePolicy {readOnly}
    - 总金额: BigDecimal {readOnly}
    + 计算退货金额(quantity): BigDecimal
  }
  class "交易方案确认\nTradeAgreement" as TradeAgreement <<entity>> {
    - 方案编号: UUID
    - 订单编号: UUID
    - 方案版本: int
    - 付款方式: PaymentMethod
    - 交付方式: DeliveryMethod
    - 见面安排: String [0..1]
    - 买家确认时间: Instant [0..1]
    - 卖家确认时间: Instant [0..1]
    - 生效时间: Instant [0..1]
    - 失效时间: Instant [0..1]
    + 双方已确认(): boolean
    + 校验组合(): void
  }
  class "普通取消申请\nCancellationRequest" as CancellationRequest <<entity>> {
    - 申请编号: UUID
    - 订单编号: UUID
    - 申请人编号: UUID
    - 对方编号: UUID
    - 原因: String
    - 申请时间: Instant
    - 对方答复: ConsentDecision
    - 答复时间: Instant [0..1]
    - 处理状态: CancellationStatus
    + 记录对方答复(decision, now): void
  }
  class "交易异常处理\nTradeException" as TradeException <<entity>> {
    - 异常编号: UUID
    - 订单编号: UUID
    - 类型: ExceptionType
    - 异常原因: String
    - 管理员编号: UUID [0..1]
    - 商品已取件: boolean
    - 退回核实状态: ReturnVerification
    - 证据地址集合: List<String>
    - 处理结论: ExceptionDecision
    - 处理时间: Instant [0..1]
    + 核实退回(condition, now): void
    + 记录结论(adminId, decision): void
  }
  Reservation "1" -- "1" Order : 同一事务建立
  Order "1" *-- "1" OrderSnapshot : 固化成交信息
  Order "1" -- "0..*" TradeAgreement : 方案历史
  Order "1" -- "0..*" CancellationRequest : 普通取消协商
  Order "1" -- "0..*" TradeException : 异常核查
}
