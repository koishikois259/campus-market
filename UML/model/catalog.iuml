package "商品与库存 catalog" #F0FDF4 {
  class "商品\nProduct" as Product <<aggregate root>> {
    - 商品编号: UUID
    - 卖家编号: UUID
    - 分类编号: UUID
    - 名称: String
    - 描述: String
    - 交易类型: TradeType
    - 单价: BigDecimal
    - 售后声明: AfterSalePolicy
    - 发布状态: ProductStatus
    - 内容版本: long
    - 创建时间: Instant
    - 更新时间: Instant
    + 校验发布内容(): void
    + 提交审核(): void
    + 应用审核结论(reviewId, version): void
  }
  class "商品分类\nCategory" as Category <<entity>> {
    - 分类编号: UUID
    - 分类名称: String
  }
  class "商品图片\nProductImage" as ProductImage <<value object>> {
    - 存储地址: String
    - 文件类型: ImageFormat
    - 文件字节数: long
    - 展示顺序: int
    + 校验大小与格式(): void
  }
  class "商品库存\nInventory" as Inventory <<entity>> {
    - 商品编号: UUID {unique}
    - 可售数量: int
    - 预约占用数量: int
    - 累计发出数量: int
    - 版本号: long
    + 尝试占用(quantity): boolean
    + 释放未发出占用(quantity): void
    + 确认发出(quantity): void
    + 接纳审核通过退回批次(lotId): void
  }
  class "商品审核记录\nProductReview" as ProductReview <<entity>> {
    - 审核编号: UUID
    - 商品编号: UUID
    - 商品内容版本: long
    - 退回批次编号: UUID [0..1]
    - 审核管理员编号: UUID [0..1]
    - 提交时间: Instant
    - 审核结论: ReviewDecision
    - 审核原因: String [0..1]
    - 审核时间: Instant [0..1]
    + 记录结论(adminId, decision, reason): void
  }
  class "退回商品批次\nReturnedLot" as ReturnedLot <<entity>> {
    - 批次编号: UUID
    - 商品编号: UUID
    - 原订单编号: UUID
    - 来源类型: ReturnSource
    - 来源记录编号: UUID
    - 退回数量: int
    - 品相: ReturnCondition
    - 批次状态: ReturnedLotStatus
    - 已恢复可售数量: int
    - 核实时间: Instant
    - 版本号: long
    + 标记待重新审核(): void
    + 标记已入可售(reviewId): void
  }
  Product "0..*" --> "1" Category : 归类
  Product "1" *-- "0..9" ProductImage : 图片
  Product "1" *-- "1" Inventory : 管理数量
  Product "1" -- "0..*" ProductReview : 审核历史
  Product "1" -- "0..*" ReturnedLot : 退回待审
  ReturnedLot "0..1" <-- "0..*" ProductReview : 针对退回批次
}
