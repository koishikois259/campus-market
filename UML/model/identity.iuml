package "用户与权限 identity" #EFF6FF {
  class "用户\nUser" as User <<entity>> {
    - 用户编号: UUID
    - 学校邮箱: String {unique}
    - 邮箱验证时间: Instant [0..1]
    - 注册时间: Instant
    - 版本号: long
    + 已验证(): boolean
  }
  class "角色\nRole" as Role <<entity>> {
    - 角色编号: UUID
    - 角色代码: RoleCode {unique}
    - 权限代码集合: Set<PermissionCode>
    + 包含权限(code): boolean
  }
  class "角色授权\nRoleGrant" as RoleGrant <<entity>> {
    - 授权编号: UUID
    - 用户编号: UUID
    - 角色编号: UUID
    - 授权来源: GrantSource
    - 授权管理员编号: UUID [0..1]
    - 授权时间: Instant
    - 撤销时间: Instant [0..1]
    + 当前有效(): boolean
    + 撤销(now): void
  }
  class "邮箱验证码\nEmailChallenge" as EmailChallenge <<entity>> {
    - 验证编号: UUID
    - 邮箱: String
    - 验证码摘要: String
    - 发送时间: Instant
    - 到期时间: Instant
    - 错误次数: int
    - 已使用: boolean
    + 核验(code, now): boolean
    + 是否失效(now): boolean
  }
  class "学校邮箱策略\nSchoolEmailPolicy" as SchoolEmailPolicy <<configuration>> {
    - 允许域名集合: Set<String>
    - 验证码有效期: Duration = 5分钟
    - 最小发送间隔: Duration = 60秒
    - 最大错误次数: int = 5
    + 允许邮箱(email): boolean
  }
  User "1" -- "0..*" RoleGrant : 获得
  Role "1" -- "0..*" RoleGrant : 指定角色
  EmailChallenge ..> SchoolEmailPolicy : 校验规则
}
