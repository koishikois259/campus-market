@startuml
!include model/style.iuml
title 07 服务职责与接口类图 · AI 初稿 v0.1\n应用服务协调跨实体事务；领域实体维护自身约束
package "应用服务 application" #F8FAFC {
  class "身份服务\nIdentityService" as IdentityService <<service>> {
    + 发送验证码(email): UUID
    + 验证并登录(email, code): UUID
    + 授予代交权限(adminId, userId): void
  }
  class "商品服务\nCatalogService" as CatalogService <<service>> {
    + 查询商品(actorId, filters): Page<Product>
    + 修改商品(actorId, productId, expectedVersion): void
    + 审核商品(adminId, reviewId, decision): void
    + 下架商品(actorId, productId): void
    + 重新上架退回批次(actorId, lotId, reviewId): void
  }
  class "订单服务\nOrderService" as OrderService <<service>> {
    + 预约(actorId, productId, quantity, expectedVersion, key): UUID
    + 答复预约(actorId, reservationId, decision): void
    + 确认方案(actorId, agreementId, version): void
    + 申请取消(actorId, orderId, reason): UUID
    + 答复取消(actorId, requestId, decision): void
    + 处理超时(orderId, now): void
    + 确认收货(actorId, orderId): void
    + 核实异常取消(adminId, exceptionId): void
  }
  class "资金服务\nFinanceService" as FinanceService <<service>> {
    + 发起线上付款(actorId, orderId, key): UUID
    + 处理支付通知(verifiedResult): void
    + 确认线下付款(actorId, orderId): void
    + 尝试结算(orderId): void
    + 执行合规退款(refundId): void
    + 处理资金结果(verifiedResult): void
    + 重试资金处理(adminId, businessId): void
  }
  class "交付与售后服务\nFulfillmentService" as FulfillmentService <<service>> {
    + 分配代交(adminId, orderId, courierId): UUID
    + 更新代交(actorId, taskId, action): void
    + 申请售后(actorId, orderId, quantity, key): UUID
    + 答复售后(actorId, requestId, decision): void
    + 请求介入(actorId, requestId): UUID
    + 管理员核查(adminId, interventionId, decision): void
    + 验收退货(actorId, requestId, result): void
    + 提醒卖家超时(requestId, now): void
  }
  class "治理与查询服务\nGovernanceService" as GovernanceService <<service>> {
    + 举报(actorId, targetType, targetId, reason): UUID
    + 处理举报(adminId, reportId, decision): void
    + 设置限制(adminId, targetId, reason, expiresAt): UUID
    + 解除限制(adminId, restrictionId, reason): void
    + 查询日志(actorId, filters): Page<AuditLog>
    + 查询统计(actorId, filters): TradeStatistics
  }
}
package "业务依赖接口 ports" #EFF6FF {
  interface "授权检查\nAuthorizationPort" as AuthorizationPort {
    + 要求权限与资源范围(actorId, action, resourceId): void
  }
  interface "用户仓储\nIdentityRepository" as IdentityRepository {
    + 按邮箱查询(email): User
    + 保存用户与授权(user, grants): void
  }
  interface "商品仓储\nCatalogRepository" as CatalogRepository {
    + 组合查询(filters, visibility): Page<Product>
    + 条件占用库存(productId, quantity, version): boolean
    + 保存审核与批次(review, lot): void
  }
  interface "交易仓储\nTradeRepository" as TradeRepository {
    + 按买家与幂等键查询(buyerId, key): Reservation
    + 保存预约与订单(reservation, order): void
    + 按版本更新订单(order, version): boolean
    + 查询商品进行中交易(productId): List<Order>
  }
  interface "资金仓储\nFinanceRepository" as FinanceRepository {
    + 查询有效支付(orderId): PaymentRecord
    + 保存资金记录(record): void
    + 创建唯一资金任务(key, payload): void
  }
  interface "交付售后仓储\nFulfillmentRepository" as FulfillmentRepository {
    + 查询有效退货占用(orderId): int
    + 保存任务与售后(record): void
  }
  interface "治理日志查询仓储\nGovernanceRepository" as GovernanceRepository {
    + 保存举报与限制(record): void
    + 追加日志(log): void
    + 按授权范围查询(filters, scope): Result
  }
  interface "事务边界\nTransactionBoundary" as TransactionBoundary {
    + 原子执行(command): Result
  }
  interface "通用支付渠道\nPaymentGateway" as PaymentGateway {
    + 付款(paymentId, amount, key): ChannelResult
    + 退款(paymentId, amount, key): ChannelResult
    + 结算(paymentId, sellerId, amount, key): ChannelResult
    + 查询支付结果(channelId): ChannelResult
    + 核验回调(rawNotification): VerifiedResult
  }
  interface "邮箱发送\nEmailGateway" as EmailGateway {
    + 发送验证码(email, code): void
  }
}
package "实现适配器 adapters" #F0FDF4 {
  class "模拟支付适配器\nMockPaymentGateway" as MockPaymentGateway <<adapter>> {
    - 模拟结果存储: Map<String, ChannelResult>
    + 配置模拟结果(scenario): void
  }
}
IdentityService ..> AuthorizationPort
CatalogService ..> AuthorizationPort
OrderService ..> AuthorizationPort
FinanceService ..> AuthorizationPort
FulfillmentService ..> AuthorizationPort
GovernanceService ..> AuthorizationPort
IdentityService ..> IdentityRepository
CatalogService ..> CatalogRepository
CatalogService ..> TradeRepository : 修改前检查占用
OrderService ..> TradeRepository
OrderService ..> CatalogRepository : 原子占用 / 释放
OrderService ..> FinanceRepository : 核验付款事实
OrderService ..> FulfillmentRepository : 核验交付事实
FinanceService ..> FinanceRepository
FinanceService ..> TradeRepository : 核验订单状态
FulfillmentService ..> FulfillmentRepository
FulfillmentService ..> TradeRepository
FulfillmentService ..> FinanceRepository
GovernanceService ..> GovernanceRepository
OrderService ..> TransactionBoundary
IdentityService ..> EmailGateway
FinanceService ..> PaymentGateway
PaymentGateway <|.. MockPaymentGateway
note bottom of TransactionBoundary
  仓储按业务边界分组，接口仅作初稿概览，后续可按聚合细分。
  所有写服务均使用数据库事务；图中仅示例订单服务的事务依赖。
  预约与库存强一致；对外资金调用用持久任务、幂等键和对账重试。
  失败操作的日志另行可靠保存，不能随失败业务事务一起丢失。
end note
note bottom of MockPaymentGateway
  初期实现模拟渠道；真实支付后续实现同一接口。
  渠道结果需验签或查询核实，不能接受客户端自报成功。
end note
@enduml
