@startuml
' v0.5: portrait layout for a standard A4 report page.
' Syntax reference: https://plantuml.com/zh/class-diagram
!pragma layout smetana
title 校园二手交易系统类图
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 0
skinparam classBackgroundColor #F5F5F5
skinparam classBorderColor #777777
skinparam ArrowColor #333333
skinparam nodesep 24
skinparam ranksep 25

class "交易平台" as CampusMarket {
  + 注册用户(): User
  + 查询商品(): List<Product>
}

class "用户" as User {
  - 邮箱: String
  - 角色: Set<Role>
  - /卖方预约: List<Reservation>
  + 登录(): void
  + 检查权限(): boolean
}

class "商品" as Product {
  - 名称: String
  - 单价: BigDecimal
  - 可用数量: int
  - 状态: ProductStatus
  - 交易类型: TradeType
  - 售后声明: AfterSalePolicy
  + 提交审核(): void
  + 下架(): void
}

class "预约" as Reservation {
  - 数量: int
  - 卖家答复: SellerDecision
  - 确认期限: Instant
  + 接受(): void
  + 拒绝(): void
}

class "订单" as Order {
  - 买方: User
  - 卖方: User
  - 成交快照: OrderSnapshot
  - 交易方式: TradeAgreement
  - 状态: OrderStatus
  + 申请取消(): void
  + 确认收货(): void
}

abstract class "支付记录" as Payment {
  - 金额: BigDecimal
  - 状态: PaymentStatus
  + 是否已付款(): boolean
}

class "线上支付" as OnlinePayment {
  - 渠道: String
  - 结算状态: SettlementStatus
  + 收货后结算(): void
  + 原路退款(): void
}

class "线下付款" as OfflinePayment {
  - 确认时间: Instant
  + 卖家确认收款(): void
}

class "代交任务" as DeliveryTask {
  - 分配管理员: User
  - 状态: DeliveryStatus
  + 记录取件(): void
  + 记录交件(): void
}

class "售后申请" as AfterSaleRequest {
  - 申请买家: User
  - 退货数量: int
  - 退款金额: BigDecimal
  - 状态: AfterSaleStatus
  + 答复申请(): void
  + 验收退货(): void
}

class "举报" as Report {
  - 举报人: User
  - 原因: String
  - 状态: ReportStatus
  + 管理员处理(): void
}

' Shared aggregation: collections of independently retained records.
CampusMarket "1" o-right-> "0..*" User : -用户
User "1" o-down-> "0..*" Product : -发布商品
User "1" o-down-> "0..*" Reservation : -买方预约
Product "1" -right-> "0..*" Reservation : -预约记录
Reservation "1" -down-> "1" Order : -对应订单
User "1" -down-> "0..*" DeliveryTask : -代交任务
Order "1" o-down-> "0..*" Payment : -支付记录
Order "1" -down-> "0..*" DeliveryTask : -代交记录
Order "1" -down-> "0..*" AfterSaleRequest : -售后申请
Product "0..1" -down-> "0..*" Report : -举报记录
Order "0..1" -left-> "0..*" Report : -举报记录
Payment <|-- OnlinePayment
Payment <|-- OfflinePayment

legend bottom
  空心菱形：聚合；实线箭头：可导航关联；空心三角：继承。
  -成员名和数量表示对象或集合成员；/ 表示推导成员。
  举报仅关联商品或订单之一。
  卖方预约通过发布商品查询。
endlegend
@enduml
